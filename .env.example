# Copy to .env (never commit the real .env) and set these in your host's env vars.
PORT=8787
NODE_ENV=production

# Required for moderation endpoints (/admin/*). Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Salt used to hash submitter IPs (so no raw IPs are stored). Set a fixed random value in prod,
# or rate-limit-by-IP history resets on every restart:
IP_SALT=

# Set to 1 to publish submissions immediately (skips the pending/review queue). Default: off.
AUTO_APPROVE=0

# Optional: where the SQLite file lives (use a persistent disk in prod).
DB_PATH=./community.db
